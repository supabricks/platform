{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supabricks.io/schemas/catalog-publication-command-v1.schema.json",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "preview"
        },
        "epoch_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "action",
        "epoch_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "publish"
        },
        "epoch_id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_preview": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_source_revision": {
          "type": "integer"
        },
        "expected_binding_revision": {
          "type": "integer"
        }
      },
      "required": [
        "action",
        "epoch_id",
        "key",
        "expected_preview",
        "expected_source_revision",
        "expected_binding_revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "status"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "resolve"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "resume"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "unpublish"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_binding_revision": {
          "type": "integer"
        }
      },
      "required": [
        "action",
        "id",
        "key",
        "expected_binding_revision"
      ],
      "additionalProperties": false
    }
  ]
}
