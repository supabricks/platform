{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Branch PostgreSQL extensions command v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "list"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "branch",
            "revision"
          ]
        }
      },
      "required": [
        "action",
        "target"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "set"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "branch",
            "revision"
          ]
        },
        "name": {
          "enum": [
            "pg_stat_statements",
            "pgcrypto",
            "pg_trgm",
            "uuid-ossp",
            "citext"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "target",
        "name",
        "enabled"
      ]
    }
  ]
}
