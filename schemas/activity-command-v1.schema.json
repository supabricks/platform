{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local PostgreSQL live activity command v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "list"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "branch",
            "revision"
          ]
        },
        "include_query_text": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "action",
        "target"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "statements"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "branch",
            "revision"
          ]
        },
        "include_query_text": {
          "type": "boolean",
          "default": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        },
        "order_by": {
          "enum": [
            "total_time",
            "mean_time",
            "calls",
            "rows"
          ],
          "default": "total_time"
        }
      },
      "required": [
        "action",
        "target"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "cancel"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "branch",
            "revision"
          ]
        },
        "snapshot": {
          "type": "string",
          "format": "uuid"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "action",
        "target",
        "snapshot",
        "pid"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "terminate"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "branch",
            "revision"
          ]
        },
        "snapshot": {
          "type": "string",
          "format": "uuid"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "action",
        "target",
        "snapshot",
        "pid"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "poll"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "action",
        "id"
      ]
    }
  ]
}
