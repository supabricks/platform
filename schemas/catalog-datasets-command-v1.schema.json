{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supabricks.io/schemas/catalog-datasets-command-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "list"
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "describe"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deployment_id": {
              "type": "string",
              "format": "uuid"
            },
            "provider_id": {
              "type": "string",
              "format": "uuid"
            },
            "publication_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "deployment_id",
            "provider_id",
            "publication_id"
          ]
        }
      },
      "required": [
        "action",
        "target"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "updates"
        },
        "logical": {
          "type": "string",
          "pattern": "^dataset\\.[a-z0-9_-]{1,63}$"
        }
      },
      "required": [
        "action",
        "logical"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "references"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deployment_id": {
              "type": "string",
              "format": "uuid"
            },
            "provider_id": {
              "type": "string",
              "format": "uuid"
            },
            "publication_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "deployment_id",
            "provider_id",
            "publication_id"
          ]
        }
      },
      "required": [
        "action",
        "target"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "owned"
        },
        "after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "discover"
        },
        "after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ]
    }
  ]
}
