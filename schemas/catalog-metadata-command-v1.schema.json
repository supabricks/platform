{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supabricks project metadata command v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "capabilities"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "health"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "namespace"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "ensure_namespace"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "list"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "describe"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "poll"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "resolve"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "required": [
        "action",
        "id",
        "expected_version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "validate_source"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "required": [
        "action",
        "id",
        "expected_version"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://supabricks.io/schemas/catalog-metadata-command-v1.schema.json"
}
