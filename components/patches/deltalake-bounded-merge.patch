-    DeltaSessionContext::with_runtime_env(builder.build()).state()
+    // A bounded FairSpillPool with a parallel full-outer hash join can park
+    // every RepartitionExec producer under backpressure (delta-rs #4614).
+    // Keep the pool and disk limits, but avoid that repartition barrier.
+    let config: SessionConfig = DeltaSessionConfig::default().into();
+    let config = if max_spill_size.is_some() {
+        let mut config = config.with_target_partitions(1);
+        // Merge puts the bounded source on the left. File-size estimates can
+        // otherwise swap the growing target into the non-spilling hash build.
+        config.options_mut().optimizer.join_reordering = false;
+        config
+    } else {
+        config
+    };
+    DeltaSessionContext::new_with_config_and_runtime(config, builder.build()).state()
 }
 
