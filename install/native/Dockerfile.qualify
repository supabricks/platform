# Test infrastructure only; the installed product does not need Docker/Python.
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl openssl python3 python3-psycopg postgresql-client-16 strace \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 qualifier
USER qualifier
WORKDIR /home/qualifier
ENV PATH=/usr/bin:/bin
