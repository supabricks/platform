# Trusted test controller only. Workloads still run in the pinned gVisor sandbox.
FROM mcr.microsoft.com/playwright:v1.63.0-noble
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    docker.io python3-venv python3-psycopg python3-boto3 python3-psutil python3-cryptography curl openssl \
    && rm -rf /var/lib/apt/lists/*
COPY e2e/native/requirements.txt /tmp/qualification-requirements.txt
COPY e2e/native/catalog/requirements.txt /tmp/catalog-qualification-requirements.txt
RUN python3 -m venv --system-site-packages /opt/qualification \
    && /opt/qualification/bin/pip install --no-cache-dir -r /tmp/qualification-requirements.txt -r /tmp/catalog-qualification-requirements.txt
ENV PATH=/opt/qualification/bin:/usr/bin:/bin:/usr/local/bin
