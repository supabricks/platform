  {
    "description": "Create a Postgres database; returns a psql connection URI. Idempotent on name.",
    "inputSchema": {
      "properties": {
        "cu_limit": {
          "description": "Compute ceiling in CU, 1 CU = 0.1 core (default 10)",
          "type": "integer"
        },
        "name": {
          "description": "Resource name; normalized to lowercase (the canonical name is echoed in every response)",
          "type": "string"
        },
        "priority": {
          "description": "Contention priority: high degrades last, low is preempted first (default standard)",
          "enum": [
            "high",
            "standard",
            "low"
          ],
          "type": "string"
        },
        "suspend_after_seconds": {
          "description": "Idle seconds before scale-to-zero (default 300)",
          "type": "integer"
        },
        "ttl_seconds": {
          "description": "Optional TTL; the platform reaps the database when it expires",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "create_database",
    "outputSchema": {
      "description": "On failure the content is {reason, retriable, suggested_action} with isError=true.",
      "properties": {
        "connection_uri": {
          "description": "present when status=ready",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "provisioning"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    }
  },
