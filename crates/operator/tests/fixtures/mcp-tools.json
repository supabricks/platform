  {
    "description": "Instant copy-on-write branch; returns its own connection URI. Branch a database, another branch (parent), and/or a moment in time (at).",
    "inputSchema": {
      "properties": {
        "at": {
          "description": "Optional branch point: an LSN (e.g. 0/1BCC200) or RFC 3339 timestamp (e.g. 2026-08-12T10:00:00Z); default = head of parent now",
          "type": "string"
        },
        "cu_limit": {
          "description": "Compute ceiling in CU (default 10)",
          "type": "integer"
        },
        "database": {
          "description": "Owning database name (the root of the branch tree)",
          "type": "string"
        },
        "name": {
          "description": "Resource name; normalized to lowercase (the canonical name is echoed in every response)",
          "type": "string"
        },
        "parent": {
          "description": "Optional parent BRANCH name — branch-of-branch; default branches the database itself",
          "type": "string"
        },
        "priority": {
          "enum": [
            "high",
            "standard",
            "low"
          ],
          "type": "string"
        },
        "ttl_seconds": {
          "description": "Optional TTL",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "database"
      ],
      "type": "object"
    },
    "name": "create_branch",
    "outputSchema": {
      "description": "On failure the content is {reason, retriable, suggested_action} with isError=true.",
      "properties": {
